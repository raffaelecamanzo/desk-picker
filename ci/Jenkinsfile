pipeline {
  agent none

  options {
    timestamps()
  }

  parameters {
    choice(name: 'DEPLOY_ENV', choices: ['dev', 'test', 'prod'], description: 'Which environment to update')
  }

  environment {
    // Set per Jenkins instance: dev -> docker ; test/prod -> k8s
    CI_MODE = "${env.CI_MODE ?: 'docker'}"

    // Non-secret Docker Hub username should be configured globally (same everywhere)
    // Example: DOCKERHUB_USER_NAME=raffaelecamanzo
    DOCKERHUB_USER_NAME = "${env.DOCKERHUB_USER_NAME ?: ''}"
    DOCKERHUB_REPO = "${env.DOCKERHUB_REPO ?: ''}"

    // where your values files are
    VALUES_FILE = "infra/values/values-${params.DEPLOY_ENV}.yaml"

    BACKEND_IMAGE  = "desk-picker-backend"
    FRONTEND_IMAGE = "desk-picker-frontend"

    // Branch strategy you described
    BASE_BRANCH = "${params.DEPLOY_ENV == 'dev' ? 'main' : params.DEPLOY_ENV}"
  }

  stages {

    stage('Checkout') {
      agent any
      steps { checkout scm }
    }

    stage('Resolve Git SHA') {
      agent any
      steps {
        script {
          env.GIT_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
          env.BACKEND_TAG  = "${env.BACKEND_IMAGE}-${env.GIT_SHA}"
          env.FRONTEND_TAG = "${env.FRONTEND_IMAGE}-${env.GIT_SHA}"
        }
      }
    }

    /* =========================================================
       DEV MODE — Docker Desktop available
       ========================================================= */
    stage('CI - Docker mode') {
      when { expression { env.CI_MODE == 'docker' } }
      agent any
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'docker-registry',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_PASS'
        )]) {
          sh '''
            set -euo pipefail

            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

            docker buildx create --use --name ci-builder >/dev/null 2>&1 || docker buildx use ci-builder
            docker buildx inspect --bootstrap

            # Build & push backend image
            docker buildx build backend \
              -f backend/Dockerfile \
              -t "$DOCKER_USER/$DOCKERHUB_REPO:$BACKEND_TAG" \
              -t "$DOCKER_USER/$DOCKERHUB_REPO:$BACKEND_IMAGE-latest" \
              --push

            # Build & push frontend image
            docker buildx build frontend \
              -f frontend/Dockerfile \
              -t "$DOCKER_USER/$DOCKERHUB_REPO:$FRONTEND_TAG" \
              -t "$DOCKER_USER/$DOCKERHUB_REPO:$FRONTEND_IMAGE-latest" \
              --push

          '''
        }
      }
    }

    /* =========================================================
       TEST / PROD — Kubernetes pods, no Docker
       Requires Kubernetes plugin.
       ========================================================= */
    stage('CI - Kubernetes mode') {
      when { expression { env.CI_MODE == 'k8s' } }
      agent none
      steps {
        script {
          podTemplate(yaml: """
    apiVersion: v1
    kind: Pod
    spec:
      containers:
      - name: tools
        image: ${env.DOCKERHUB_USER_NAME}/${env.DOCKERHUB_REPO}:ci-tools
        tty: true
        command: ["sh","-lc","cat"]
      - name: buildkit
        image: moby/buildkit:latest
        tty: true
        command: ["sh","-lc","buildkitd --addr unix:///run/buildkit/buildkitd.sock & sleep infinity"]
    """) {
            node(POD_LABEL) {
              container('tools') {
                sh '''
                  set -euo pipefail
                  cd backend
                  mvn -B clean verify
                  cd ../frontend
                  npm ci
                  npm run build
                '''
              }
              container('buildkit') {
                sh '''
                  set -euo pipefail
                  # buildctl commands...
                '''
              }
            }
          }
        }
      }
    }

    stage('Update Helm values') {
      agent any
      steps {
        sh """
          set -euo pipefail

          docker run --rm \
            -v "\$PWD:/workspace" \
            -w /workspace \
            -e VALUES_FILE="${env.VALUES_FILE}" \
            -e BACKEND_TAG="${env.BACKEND_TAG}" \
            -e FRONTEND_TAG="${env.FRONTEND_TAG}" \
            raffaelecamanzo/local-build-images:ci-tools \
            bash -lc '
              set -euo pipefail
              yq -i ".backend.image.tag = \\"$BACKEND_TAG\\" | .frontend.image.tag = \\"$FRONTEND_TAG\\"" "$VALUES_FILE"
              git diff -- "$VALUES_FILE" || true
            '
        """
      }
    }

    stage('GitOps - Push dev to main') {
      when { expression { params.DEPLOY_ENV == 'dev' } }
      agent any
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh """
            set -euo pipefail

            docker run --rm \
              -v "\$PWD:/workspace" \
              -w /workspace \
              -e VALUES_FILE="${env.VALUES_FILE}" \
              -e GIT_SHA="${env.GIT_SHA}" \
              -e GITHUB_TOKEN="\$GITHUB_TOKEN" \
              raffaelecamanzo/local-build-images:ci-tools \
              bash -lc '
                set -euo pipefail

                git checkout main
                git pull --ff-only

                git config user.email "ci@sourcesense.local"
                git config user.name  "ci-bot"

                git add "$VALUES_FILE"
                git commit -m "deploy(dev): $GIT_SHA [skip ci]" || exit 0

                git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/raffaelecamanzo/desk-picker.git"
                git push origin main
              '
          """
        }
      }
    }

    stage('GitOps - PR to test/prod') {
      when { expression { params.DEPLOY_ENV != 'dev' } }
      agent any
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh '''
            set -euo pipefail
            export GH_TOKEN="$GITHUB_TOKEN"

            # checkout the target env branch
            git fetch origin "$BASE_BRANCH"
            git checkout -B "$BASE_BRANCH" "origin/$BASE_BRANCH"

            BRANCH="promote/${DEPLOY_ENV}/${GIT_SHA}"
            git checkout -b "$BRANCH"

            git config user.email "ci@sourcesense.local"
            git config user.name  "ci-bot"

            git add "$VALUES_FILE"
            git commit -m "promote(${DEPLOY_ENV}): ${GIT_SHA}" || exit 0

            git remote set-url origin "https://x-access-token:${GITHUB_TOKEN}@github.com/raffaelecamanzo/desk-picker.git"
            git push -u origin "$BRANCH"

            gh pr create \
              --base "$BASE_BRANCH" \
              --head "$BRANCH" \
              --title "Promote to ${DEPLOY_ENV}: ${GIT_SHA}" \
              --body "Update ${VALUES_FILE} to backend=${BACKEND_TAG}, frontend=${FRONTEND_TAG}"
          '''
        }
      }
    }
  }

  post {
    always {
      script {
        if (env.CI_MODE == 'docker') {
          node {
            sh 'docker logout || true'
          }
        }
      }
    }
  }
}